# ==============================================================================
# MyArea24 Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets or production keys to source control.
# Copy this file to '.env' and populate your local credentials.

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME=MyArea24
LOG_LEVEL=INFO
DEBUG=true

# Database Connection URL
# For local development without Postgres: sqlite:///./myarea24.db
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/myarea24
DATABASE_URL=sqlite:///./myarea24.db

# Weather Provider Credentials
WEATHERAPI_API_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# Traffic Provider Configuration (TomTom Primary)
TRAFFIC_PROVIDER=tomtom
TOMTOM_API_KEY=
TOMTOM_TRAFFIC_BASE_URL=https://api.tomtom.com/traffic/services/5

# Optional Fallback (HERE Traffic)
HERE_API_KEY=
HERE_TRAFFIC_BASE_URL=https://data.traffic.hereapi.com/v7

# NDMA SACHET CAP Feed URL
SACHET_FEED_URL=https://sachet.ndma.gov.in/backend/cap/rss/all/en

# Ingestion Worker Settings
INGESTION_ENABLED=false
WEATHER_POLL_INTERVAL_MINUTES=30
TRAFFIC_POLL_INTERVAL_MINUTES=10
SACHET_POLL_INTERVAL_MINUTES=15
HTTP_TIMEOUT_SECONDS=10.0
MAX_HTTP_RETRIES=3

# Deterministic Correlation Rule Configuration (Scenario D: Monsoon Commute)
RULE_RAIN_THRESHOLD_MM_PER_HR=8.0
RULE_JAM_FACTOR_THRESHOLD=6.5
RULE_DELAY_THRESHOLD_SECONDS=900
RULE_SPATIAL_RADIUS_KM=5.0
RULE_EVALUATION_WINDOW_START=17:30
RULE_EVALUATION_WINDOW_END=20:30
RULE_SIGNAL_MAX_AGE_MINUTES=60
RULE_TIMEZONE=Asia/Kolkata

# Pilot Locations (JSON array of {name, lat, lon})
# Default: 5 key commuter nodes in Delhi-NCR and Bengaluru
PILOT_LOCATIONS='[{"name": "Delhi AIIMS Ring Road", "lat": 28.5672, "lon": 77.2100}, {"name": "Delhi Connaught Place", "lat": 28.6304, "lon": 77.2177}, {"name": "Delhi Rohini Sector 11", "lat": 28.7144, "lon": 77.1197}, {"name": "Bengaluru Silk Board", "lat": 12.9176, "lon": 77.6233}, {"name": "Bengaluru Indiranagar", "lat": 12.9784, "lon": 77.6408}]'

# Pilot Traffic Bounding Box (minLon, minLat, maxLon, maxLat)
# Default: Delhi South / Central Ring Road corridor
PILOT_TRAFFIC_BBOX=77.1500,28.5200,77.2600,28.6200
